<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Extend <%= cfg.itemLabel %> — Student Portal System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="sidebar">
    <div class="logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
    </div>
      <div class="sidebar-profile">
        <div class="avatar"><%= (user && (user.full_name || user.username) ? (user.full_name || user.username).charAt(0).toUpperCase() : 'A') %></div>
        <div class="profile-meta">
          <span class="profile-name"><%= user ? (user.full_name || user.username) : 'Admin' %></span>
          <span class="profile-role">Administrator</span>
        </div>
      </div>
    <nav>
      <a href="/admin">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg>
        Dashboard
      </a>
      <a href="/admin/exams">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        Exams
      </a>
      <a href="/admin/quizzes">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
        Quizzes
      </a>
      <a href="/admin/users">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        Users
      </a>
      <a href="/logout" class="logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Logout
      </a>
    </nav>
  </div>

  <div class="main-content">
    <header class="page-header">
      <h1>Extend <%= cfg.itemLabel %>: <%= item.title %></h1>
      <p>Give individual students extra time after the deadline — only those who haven't taken it yet are listed. Extensions never override Disable.</p>
    </header>

    <div style="margin-bottom: var(--space-4);">
      <a href="<%= cfg.basePath %>" class="btn btn-secondary" style="text-decoration:none;">← Back to <%= cfg.itemLabel %>s</a>
    </div>

    <div id="alertSuccess" class="alert alert-success"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg><span id="alertSuccessText"></span><button class="close" onclick="this.parentElement.classList.remove('show')">&times;</button></div>
    <div id="alertError" class="alert alert-danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg><span id="alertErrorText"></span><button class="close" onclick="this.parentElement.classList.remove('show')">&times;</button></div>

    <div class="card" style="margin-bottom: var(--space-5);">
      <div class="card-header">
        <h3>Grant Extension</h3>
        <span class="meta">Original due: <%= item.due_date || 'none' %> · Status: <%= Number(item.active) === 0 ? 'Disabled' : 'Enabled' %></span>
      </div>
      <div class="card-body">
        <% if (!untaken.length) { %>
          <p style="color:var(--text-muted);">Everyone has already taken this <%= cfg.itemLabel.toLowerCase() %> — nobody left to extend. 🎉</p>
        <% } else { %>
        <form action="<%= cfg.basePath %>/<%= item.id %>/extensions" method="post">
          <div class="form-group" style="max-width:280px;">
            <label>Extended Due Date (until 11:59 PM)</label>
            <input type="date" name="due_date" required value="<%= item.due_date || '' %>">
          </div>
          <div class="form-group">
            <label>Students who haven't taken it yet (<span id="untakenCount"><%= untaken.length %></span>)</label>
            <div style="display:flex; gap:var(--space-2); align-items:center; flex-wrap:wrap; margin-bottom:var(--space-2);">
              <input type="text" id="stuSearch" placeholder="🔍 Search name, username, student ID, SET..." style="flex:1; min-width:220px;" autocomplete="off">
              <label style="font-size:var(--text-sm); white-space:nowrap;"><input type="checkbox" id="checkAll"> Select all</label>
            </div>
            <p class="form-hint" id="noMatchHint" style="display:none; color:var(--color-warning);">No students match your search.</p>
            <div class="table-wrap" style="max-height:320px; overflow-y:auto;">
              <table class="table">
                <thead><tr><th></th><th>Student</th><th>Student ID</th><th>SET</th></tr></thead>
              <tbody id="stuTableBody">
                  <% untaken.forEach(s => { %>
                    <tr data-search="<%= ((s.full_name || '') + ' ' + (s.username || '') + ' ' + (s.student_id || '') + ' ' + (s.set_group || '')).toLowerCase() %>">
                      <td><input type="checkbox" name="student_ids" value="<%= s.id %>" class="stu-check"></td>
                      <td class="cell-primary"><%= s.full_name || s.username %> <span class="cell-muted" style="font-size:var(--text-xs);">(<%= s.username %>)</span></td>
                      <td><%= s.student_id || '—' %></td>
                      <td class="text-center"><span class="badge badge-set"><%= s.set_group || '—' %></span></td>
                    </tr>
                  <% }) %>
              </tbody>
              </table>
            </div>
          </div>
          <div class="card-footer">
            <button type="submit" class="btn btn-primary">Grant Extension</button>
          </div>
        </form>
        <% } %>
      </div>
    </div>

    <div class="card" style="padding:0; overflow:hidden;">
      <div class="card-header">
        <h3>Current Extensions (<%= grants.length %>)</h3>
      </div>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Student</th><th>Student ID</th><th>Extended Until</th><th class="text-right">Actions</th></tr></thead>
          <tbody>
            <% if (!grants.length) { %>
              <tr><td colspan="4" style="text-align:center; color:var(--text-muted); padding:1.5rem;">No extensions granted yet.</td></tr>
            <% } %>
            <% grants.forEach(g => { %>
              <tr>
                <td class="cell-primary"><%= g.full_name || g.username %></td>
                <td><%= g.student_id || '—' %></td>
                <td><span class="badge badge-warning"><%= g.due_date %> (11:59 PM)</span></td>
                <td class="text-right">
                  <form action="<%= cfg.basePath %>/extensions/revoke" method="post" class="d-inline" data-message="Revoke extension for <%= g.full_name || g.username %>?" data-confirm-text="Revoke" data-danger="true">
                    <input type="hidden" name="id" value="<%= g.id %>">
                    <button class="btn btn-danger btn-sm" type="submit">Revoke</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <footer class="footer">
      &copy; 2026 Student Portal System &mdash; Developed by <strong>BART</strong> | Crafted with &hearts; for Education<br>
      <small>All Rights Reserved &bull; Made in the Philippines &bull; v1.0</small>
    </footer>
  </div>

  <script src="/ui.js"></script>
  <script>
    uiShowUrlAlerts();
    uiConfirmForms();
    const visibleChecks = () => [...document.querySelectorAll('#stuTableBody tr')]
      .filter(tr => tr.style.display !== 'none')
      .map(tr => tr.querySelector('.stu-check'));
    document.getElementById('checkAll')?.addEventListener('change', function() {
      visibleChecks().forEach(c => { c.checked = this.checked; });
    });
    // Live search: filter rows by name, username, student ID or SET
    document.getElementById('stuSearch')?.addEventListener('input', function() {
      const q = this.value.trim().toLowerCase();
      let shown = 0;
      document.querySelectorAll('#stuTableBody tr').forEach(tr => {
        const hit = !q || (tr.getAttribute('data-search') || '').includes(q);
        tr.style.display = hit ? '' : 'none';
        if (hit) shown++;
      });
      document.getElementById('untakenCount').textContent = shown + (q ? ' (filtered)' : '');
      document.getElementById('noMatchHint').style.display = shown ? 'none' : 'block';
      // keep "select all" in sync: unchecked when searching
      const ca = document.getElementById('checkAll');
      if (ca && q) ca.checked = false;
    });
  </script>
</body>
</html>
