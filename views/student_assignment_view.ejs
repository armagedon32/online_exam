<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= assignment.title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav class="navbar" role="navigation" aria-label="Main navigation">
    <div class="nav-left">
      <div class="nav-logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="8.5" cy="7" r="4"></circle>
          <path d="M12 11h.01"></path>
          <path d="M14 8h.01"></path>
        </svg>
      </div>
      <span class="brand">Online Exam</span>
      <a href="/student" class="nav-link">Dashboard</a>
      <a href="/student/lessons" class="nav-link">Lessons</a>
      <a href="/student/assignments" class="nav-link active" aria-current="page">Assignments</a>
      <a href="/change-password" class="nav-link">Change Password</a>
    </div>
    <div class="nav-right">
      <div class="nav-avatar"><%= (user.full_name || user.username || '?').charAt(0).toUpperCase() %></div>
      <span><%= user.full_name || user.username %> · <%= user.course || '' %> <%= user.year_level ? '· ' + user.year_level : '' %></span>
      <a href="/logout" class="nav-logout" data-ui-confirm="Log out of your account?" data-confirm-text="Logout" data-danger="true">Logout</a>
    </div>
  </nav>

  <div class="dashboard-container" style="max-width: 760px; margin: var(--space-8) auto; padding: 0 var(--space-6);">
    <div style="margin-bottom: var(--space-4);">
      <a href="/student/assignments" class="btn btn-secondary" style="padding:0.6rem 1rem; text-decoration:none;">← Back to Assignments</a>
    </div>

    <div id="alertSuccess" class="alert alert-success"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg><span id="alertSuccessText"></span><button class="close" onclick="this.parentElement.classList.remove('show')">&times;</button></div>
    <div id="alertError" class="alert alert-danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg><span id="alertErrorText"></span><button class="close" onclick="this.parentElement.classList.remove('show')">&times;</button></div>
    <div id="alertWarning" class="alert alert-warning"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg><span id="alertWarningText"></span><button class="close" onclick="this.parentElement.classList.remove('show')">&times;</button></div>

    <div class="card" style="margin-bottom: var(--space-4);">
      <div class="card-body">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:var(--space-3); flex-wrap:wrap; margin-bottom:var(--space-3);">
          <h1 style="font-size: var(--text-2xl); font-weight: var(--font-extrabold); color: var(--text-primary); margin:0;"><%= assignment.title %></h1>
          <% if (mySub) { %>
            <% if (mySub.status === 'done') { %>
              <span class="badge badge-success">Done ✓</span>
            <% } else { %>
              <span class="badge badge-warning">Submitted</span>
            <% } %>
          <% } else { %>
            <span class="badge badge-role">Not Submitted</span>
          <% } %>
        </div>
        <p style="margin: 0 0 var(--space-3); display: flex; gap: var(--space-2); flex-wrap: wrap; align-items: center;">
          <% if (assignment.subject) { %><span class="badge badge-primary"><%= assignment.subject %></span><% } %>
          <% if (assignment.due_date) { %><span class="badge badge-warning">Due: <%= assignment.due_date %></span><% } %>
        </p>
        <% if (assignment.description) { %>
          <div style="margin-top: var(--space-4); padding: var(--space-4); background: var(--bg-secondary); border-radius: var(--radius-md);">
            <strong style="font-size: var(--text-sm); color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Instructions</strong>
            <p style="margin: var(--space-2) 0 0; white-space: pre-wrap; color: var(--text-primary);"><%= assignment.description %></p>
          </div>
        <% } %>
      </div>
    </div>

    <% if (mySub) { %>
      <div class="card" style="margin-bottom: var(--space-4);">
        <div class="card-header"><h3>Your Submission</h3><span class="meta"><%= mySub.status === 'done' ? 'Graded by teacher' : 'Awaiting teacher review' %></span></div>
        <div class="card-body">
          <% if (mySub.status === 'done' && (mySub.score || mySub.feedback)) { %>
            <div style="margin-bottom: var(--space-4); padding: var(--space-4); background: var(--bg-tertiary); border: 1px solid var(--color-300); border-radius: var(--radius-md);">
              <label style="font-size:var(--text-xs); color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; font-weight:600;">Your Score</label>
              <div style="font-size: var(--text-3xl); font-weight: var(--font-extrabold); color: var(--color-primary); margin-top: var(--space-1);"><%= mySub.score || '—' %></div>
              <% if (mySub.feedback) { %>
                <div style="margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--border-light);">
                  <label style="font-size:var(--text-xs); color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; font-weight:600;">Teacher's Feedback</label>
                  <p style="margin: var(--space-2) 0 0; white-space:pre-wrap; color:var(--text-primary);">💬 <%= mySub.feedback %></p>
                </div>
              <% } %>
            </div>
          <% } %>
          <% if (mySub.text_response) { %>
            <div style="margin-bottom: var(--space-3);">
              <label style="font-size:var(--text-xs); color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; font-weight:600;">Your Response</label>
              <p style="margin: var(--space-2) 0 0; white-space: pre-wrap; background: var(--bg-secondary); padding: var(--space-3); border-radius: var(--radius-md);"><%= mySub.text_response %></p>
            </div>
          <% } %>
          <% if (mySub.link_url) { %>
            <div style="margin-bottom: var(--space-3);">
              <label style="font-size:var(--text-xs); color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; font-weight:600;">Your Link</label>
              <p style="margin: var(--space-2) 0 0;"><a href="<%= mySub.link_url %>" target="_blank" rel="noopener" style="color:var(--color-primary); word-break:break-all;">🔗 <%= mySub.link_url %></a></p>
            </div>
          <% } %>
          <% if (mySub.file_name) { %>
            <div style="margin-bottom: var(--space-3);">
              <label style="font-size:var(--text-xs); color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; font-weight:600;">Your File</label>
              <p style="margin: var(--space-2) 0 0;">📎 <%= mySub.file_name %> <span class="cell-muted">(already sent to your teacher)</span></p>
            </div>
          <% } %>
          <div style="margin-top: var(--space-3); display:flex; gap:var(--space-2); flex-wrap:wrap; align-items:center;">
            <% if (mySub.status !== 'done') { %>
              <form action="/student/assignments/<%= assignment.id %>/withdraw" method="post" data-message="Withdraw your submission?<br><small>You will be able to resubmit.</small>" data-confirm-text="Withdraw" data-danger="true">
                <button class="btn btn-danger btn-sm" type="submit">Withdraw Submission</button>
              </form>
            <% } %>
            <span class="cell-muted" style="font-size:var(--text-sm);">Submitted: <%= mySub.submitted_at %></span>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="card">
        <div class="card-header"><h3>Submit Your Work</h3></div>
        <div class="card-body">
          <form action="/student/assignments/<%= assignment.id %>/submit" method="post" enctype="multipart/form-data">
            <div class="form-group">
              <label>Your Answer / Response</label>
              <textarea name="text_response" rows="5" placeholder="Type your answer here..."></textarea>
            </div>
            <div class="form-group">
              <label>Video Link (optional)</label>
              <input type="url" name="link_url" placeholder="https://youtube.com/... or any link">
            </div>
            <div class="form-group">
              <label>Upload File (optional, max 10MB)</label>
              <input type="file" name="file" accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.png,.jpg,.jpeg,.zip,.mp4,.mp3">
              <p class="hint" style="color:var(--text-muted); font-size:var(--text-xs); margin-top:var(--space-2);">You can submit a text response, a link, a file — or all three.</p>
            </div>
            <div class="card-footer">
              <button type="submit" class="btn btn-primary">Mark as Submitted</button>
            </div>
          </form>
        </div>
      </div>
    <% } %>
  </div>

  <footer class="footer">
    &copy; 2026 Online Exam System &mdash; Developed by <strong>BART</strong> | Crafted with &hearts; for Education<br>
    <small>All Rights Reserved &bull; Made in the Philippines &bull; v1.0</small>
  </footer>

  <script src="/ui.js"></script>
  <script>
    uiShowUrlAlerts();
    uiConfirmForms();
  </script>
</body>
</html>