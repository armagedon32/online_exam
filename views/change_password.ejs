<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change Password</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  






<style>
    .footer { margin-top: 2.5rem; padding: 1.5rem 1rem; text-align: center; border-top: 1px solid #e2e8f0; color: #64748b; font-size: 0.8rem; background: transparent; }
    .footer strong { color: #1e293b; }
    .footer small { color: #94a3b8; }</style>
</head>
<body>
  <div class="auth-wrap">
  <div class="card">
    <h2 style="margin:0 0 0.35rem 0; text-align:center;">Change Password</h2>
    <p style="text-align:center; color:var(--muted); font-size:0.85rem; margin:0 0 1.2rem 0;">Hello <%= user.username %> — enter current and new password</p>
    <div id="alertError" class="alert alert-danger"></div>
    <div id="alertSuccess" class="alert alert-success"></div>
    <form action="/change-password" method="post">
      <div class="form-group"><label>Current Password (temp password if reset)</label><input type="password" name="current_password" required></div>
      <div class="form-group"><label>New Password</label><input type="password" name="new_password" required></div>
      <div class="form-group"><label>Confirm New Password</label><input type="password" name="confirm_password" required></div>
      <button type="submit" class="btn">Update Password</button>
    </form>
    <a href="<%= user.role==='admin' ? '/admin' : '/student' %>" class="back">← Back to Dashboard</a>
    </div>
  </div>
  <script>
    const qs = new URLSearchParams(location.search);
    const err = qs.get('error'), suc = qs.get('success');
    if (err) { const el=document.getElementById('alertError'); el.textContent=decodeURIComponent(err.replace(/\+/g,' ')); el.classList.add('show'); }
    if (suc) { const el=document.getElementById('alertSuccess'); el.textContent=decodeURIComponent(suc.replace(/\+/g,' ')); el.classList.add('show'); }
  </script>

  
  
  
  <footer class="footer">
    &copy; 2026 Online Exam System &mdash; Developed by <strong>BART</strong> | Crafted with &hearts; for Education<br>
    <small>All Rights Reserved &bull; Made in the Philippines &bull; v1.0</small>
  </footer>
</body>
</html>