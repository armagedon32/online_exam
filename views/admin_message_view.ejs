<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Messages with <%= student.full_name %> — Online Exam System</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="sidebar">
    <div class="logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div>
    <div class="sidebar-profile">
      <div class="avatar"><%= (user && (user.full_name || user.username) ? (user.full_name || user.username).charAt(0).toUpperCase() : 'A') %></div>
      <div class="profile-meta">
        <span class="profile-name"><%= user ? (user.full_name || user.username) : 'Admin' %></span>
        <span class="profile-role">Administrator</span>
      </div>
    </div>
    <nav>
      <a href="/admin"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg> Dashboard</a>
      <a href="/admin/questions/add"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"></path></svg> Questions</a>
      <a href="/admin/exams/create"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"></polyline></svg> Create Exam</a>
      <a href="/admin/lessons"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg> Lessons</a>
      <a href="/admin/assignments"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg> Assignments</a>
      <a href="/admin/scores"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg> Scores</a>
      <a href="/admin/messages" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg> Messages</a>
      <a href="/admin/users"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg> Users</a>
      <a href="/admin/settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06-.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 9 15a1.65 1.65 0 0 0-1-1.51V13a1.65 1.65 0 0 0 1-1.51 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 13 7a1.65 1.65 0 0 0 1 1.51V9a1.65 1.65 0 0 0-1 1.51 1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1 2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 15a1.65 1.65 0 0 0 1 1.51V17a2 2 0 0 1 4 0v-.09a1.65 1.65 0 0 0 1-1.51z"></path></svg> Settings</a>
      <a href="/logout" class="logout"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg> Logout</a>
    </nav>
  </div>
  <div class="main-content">
    <div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-start; gap:var(--space-4); flex-wrap:wrap;">
      <div>
        <h1>Conversation with <%= student.full_name %></h1>
        <p>@<%= student.username %> — reply to answer their query</p>
      </div>
      <a href="/admin/messages" class="btn btn-secondary" style="padding:0.6rem 1rem; text-decoration:none;">← All Messages</a>
    </div>

    <div id="alertSuccess" class="alert alert-success"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg><span id="alertSuccessText"></span><button class="close" onclick="this.parentElement.classList.remove('show')">&times;</button></div>
    <div id="alertError" class="alert alert-danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg><span id="alertErrorText"></span><button class="close" onclick="this.parentElement.classList.remove('show')">&times;</button></div>

    <div class="card" style="padding:0; overflow:hidden;">
      <div style="padding: var(--space-4) var(--space-5); border-bottom:1px solid var(--border-light); background:var(--bg-tertiary); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:var(--space-2);">
        <strong style="font-size:var(--text-sm);">💬 <%= student.full_name %></strong>
        <span class="meta"><%= messages.length === 0 ? 'No messages yet' : messages.length + ' message(s)' %></span>
      </div>
      <div id="msgThread" style="padding: var(--space-4); max-height: 480px; overflow-y: auto; display:flex; flex-direction:column; gap:var(--space-3); background:var(--bg-secondary);">
        <% if (messages.length === 0) { %>
          <div class="empty-state" style="padding: var(--space-8) var(--space-4);">
            <h3>No messages in this thread</h3>
            <p>Send a reply below to start the conversation.</p>
          </div>
        <% } else { %>
          <% messages.forEach(m => {
               const mine = m.sender_id === user.userId;
          %>
            <div style="align-self: <%= mine ? 'flex-end' : 'flex-start' %>; max-width: 78%;">
              <div style="background:<%= mine ? 'var(--color-primary)' : '#fff' %>; color:<%= mine ? '#fff' : 'var(--text-primary)' %>; padding: var(--space-3) var(--space-4); border-radius: <%= mine ? 'var(--radius-md) var(--radius-md) var(--radius-sm) var(--radius-md)' : 'var(--radius-md) var(--radius-md) var(--radius-md) var(--radius-sm)' %>; box-shadow: 0 1px 2px rgba(0,0,0,0.06);">
                <div style="font-size:var(--text-xs); font-weight:600; opacity:0.8; margin-bottom:var(--space-1);"><%= mine ? 'You' : student.full_name %></div>
                <div style="white-space:pre-wrap; word-break:break-word; font-size:var(--text-sm);"><%= m.message %></div>
                <div style="font-size:var(--text-xs); opacity:0.7; margin-top:var(--space-1); text-align:right;"><%= m.created_at %></div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
      <form action="/admin/messages/reply" method="post" style="padding: var(--space-4); border-top:1px solid var(--border-light); background:var(--bg-tertiary);">
        <input type="hidden" name="student_id" value="<%= student.id %>">
        <div class="form-group" style="margin-bottom:var(--space-3);">
          <textarea name="message" rows="3" placeholder="Type your reply to <%= student.full_name %>..." required style="resize:vertical;"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send Reply</button>
      </form>
    </div>
  </div>

  <script src="/ui.js"></script>
  <script src="/notifications.js"></script>
  <script>
    uiShowUrlAlerts();
    var threadEl = document.getElementById('msgThread');
    if (threadEl) threadEl.scrollTop = threadEl.scrollHeight;
  </script>
</body>
</html>