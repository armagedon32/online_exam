<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up — Online Exam System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <style>
    .signup-page { min-height: 100vh; display: flex; align-items: flex-start; justify-content: center; padding: var(--space-8) var(--space-6); background: linear-gradient(135deg, var(--bg-primary) 0%, var(--color-100) 100%); }
    .signup-card { width: 100%; max-width: 640px; background: var(--bg-secondary); border: 1px solid var(--border-light); border-radius: var(--radius-xl); box-shadow: var(--shadow-xl); padding: var(--space-8); }
    .signup-header { text-align: center; margin-bottom: var(--space-8); }
    .signup-logo { width: 56px; height: 56px; margin: 0 auto var(--space-5); background: linear-gradient(135deg, var(--color-success), #10b981); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; }
    .signup-logo svg { width: 28px; height: 28px; color: var(--color-white); }
    .signup-header h1 { font-size: var(--text-2xl); font-weight: var(--font-extrabold); color: var(--text-primary); margin-bottom: var(--space-2); letter-spacing: -0.02em; }
    .signup-header p { color: var(--text-muted); font-size: var(--text-base); font-weight: var(--font-normal); max-width: 400px; margin: 0 auto; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
    .grid-3 { display: grid; grid-template-columns: 1fr 1fr 110px; gap: var(--space-4); }
    @media (max-width: 640px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }
    .form-group { margin-bottom: var(--space-4); }
    .form-group label { font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: var(--space-2); display: block; }
    .form-hint { font-size: var(--text-xs); color: var(--text-muted); margin-top: var(--space-1); display: block; }
    .subjects-box {
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: var(--space-4);
      max-height: 200px;
      overflow-y: auto;
      background: var(--bg-tertiary);
    }
    .subject-item {
      display: flex;
      align-items: flex-start;
      gap: var(--space-3);
      padding: var(--space-3);
      background: var(--bg-secondary);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      margin-bottom: var(--space-2);
      cursor: pointer;
      transition: all var(--transition-fast);
    }
    .subject-item:hover { border-color: var(--color-primary); background: var(--color-primary-light); }
    .subject-item input { margin-top: 0.125rem; accent-color: var(--color-primary); width: 16px; height: 16px; flex-shrink: 0; }
    .subject-item strong { font-size: var(--text-sm); font-weight: var(--font-semibold); display: block; }
    .subject-item small { color: var(--text-muted); font-size: var(--text-xs); display: block; margin-top: var(--space-1); }
    .btn-submit { width: 100%; padding: 0.875rem 1rem; font-size: var(--text-base); font-weight: var(--font-semibold); margin-top: var(--space-2); }
    .login-prompt { text-align: center; margin-top: var(--space-6); font-size: var(--text-sm); color: var(--text-muted); }
    .login-prompt a { font-weight: var(--font-semibold); color: var(--color-primary); }
    .login-prompt a:hover { color: var(--color-primary-hover); }
    .footer { margin-top: var(--space-10); padding-top: var(--space-6); border-top: 1px solid var(--border-light); text-align: center; color: var(--text-muted); font-size: var(--text-xs); }
    .footer strong { color: var(--text-primary); }
  </style>
</head>
<body>
  <div class="signup-page">
    <div class="signup-card">
      <div class="signup-header">
        <div class="signup-logo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="8.5" cy="7" r="4"></circle>
            <line x1="20" y1="8" x2="20" y2="14"></line>
            <line x1="23" y1="11" x2="17" y2="11"></line>
          </svg>
        </div>
        <h1>Create Student Account</h1>
        <p>
          <% if (refAdmin) { %>
            You are enrolling in <strong style="color: var(--color-primary);"><%= refAdmin.full_name || refAdmin.username %></strong>'s class.
          <% } else { %>
            Full Name, Course, Year & Subjects — only your subjects' exams will appear
          <% } %>
        </p>
      </div>

      <div id="alertError" class="alert alert-danger" role="alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <span id="alertErrorText"></span>
      </div>
      <div id="alertSuccess" class="alert alert-success" role="alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <span id="alertSuccessText"></span>
      </div>

      <form action="/signup" method="post" id="signupForm" novalidate>
        <% if (ref) { %><input type="hidden" name="ref" value="<%= ref %>"><% } %>
        <div class="form-group">
          <label for="full_name">Full Name</label>
          <input type="text" id="full_name" name="full_name" placeholder="e.g., Juan Dela Cruz" required autocomplete="name">
        </div>

        <div class="grid-3">
          <div class="form-group">
            <label for="course">Course</label>
            <input type="text" id="course" name="course" placeholder="e.g., BSIT, BSED, BSHM" required autocomplete="off">
          </div>
          <div class="form-group">
            <label for="year_level">Year Level</label>
            <select id="year_level" name="year_level" required>
              <option value="">— Select Year —</option>
              <option value="1st Year">1st Year</option>
              <option value="2nd Year">2nd Year</option>
              <option value="3rd Year">3rd Year</option>
              <option value="4th Year">4th Year</option>
            </select>
          </div>
          <div class="form-group">
            <label for="set_group">SET</label>
            <select id="set_group" name="set_group" required>
              <option value="">— A-Z —</option>
              <% for(let c=65; c<=90; c++){ const l=String.fromCharCode(c); %>
                <option value="<%= l %>"><%= l %></option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>Subjects <span style="font-weight:var(--font-normal); text-transform:none; color:var(--text-muted); font-size:var(--text-xs);">— from Admin Settings</span></label>
          <div class="subjects-box" role="group" aria-label="Select your subjects">
            <% if (subjects && subjects.length) { %>
              <% subjects.forEach(s => { %>
                <label class="subject-item">
                  <input type="checkbox" name="subjects" value="<%= s.name %>">
                  <div>
                    <strong><%= s.name %></strong>
                    <% if (s.code) { %><small><%= s.code %></small><% } %>
                    <% if (s.schedule) { %><small><%= s.schedule %></small><% } %>
                  </div>
                </label>
              <% }) %>
            <% } else { %>
              <p style="color: var(--text-muted); font-size: var(--text-sm); text-align:center; margin:var(--space-4) 0;">No subjects yet — ask Admin to add in Settings.</p>
            <% } %>
          </div>
          <span class="form-hint">Only exams matching your selected subjects will appear on your dashboard.</span>
          <% if (!refAdmin && !subjects.length) { %>
            <span class="form-hint" style="color: var(--color-danger); margin-top: var(--space-2);">You used a sign-up link from a teacher with no subjects yet.</span>
          <% } %>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" placeholder="Choose username" required autocomplete="username">
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="Create password" required autocomplete="new-password" minlength="6">
          </div>
        </div>

        <button type="submit" class="btn btn-success btn-lg btn-submit">Create Account</button>
      </form>

      <p class="login-prompt">Already have an account? <a href="/login">Sign in</a></p>

      <footer class="footer">
        &copy; 2026 Online Exam System &mdash; Developed by <strong>BART</strong> | Crafted with &hearts; for Education<br>
        <small>All Rights Reserved &bull; Made in the Philippines &bull; v1.0</small>
      </footer>
    </div>
  </div>

  <script>
    const qs = new URLSearchParams(location.search);
    const err = qs.get('error'), suc = qs.get('success');
    if (err) {
      const el = document.getElementById('alertErrorText');
      const alertEl = document.getElementById('alertError');
      el.textContent = decodeURIComponent(err.replace(/\+/g, ' '));
      alertEl.classList.add('show');
    }
    if (suc) {
      const el = document.getElementById('alertSuccessText');
      const alertEl = document.getElementById('alertSuccess');
      el.textContent = decodeURIComponent(suc.replace(/\+/g, ' '));
      alertEl.classList.add('show');
    }
  </script>
</body>
</html>