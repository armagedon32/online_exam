<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lesson Progress — <%= lesson.title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="sidebar">
    <div class="logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div>
      <div class="sidebar-profile">
        <div class="avatar"><%= (user && (user.full_name || user.username) ? (user.full_name || user.username).charAt(0).toUpperCase() : 'A') %></div>
        <div class="profile-meta">
          <span class="profile-name"><%= user ? (user.full_name || user.username) : 'Admin' %></span>
          <span class="profile-role">Administrator</span>
        </div>
      </div>
    <nav>
      <a href="/admin"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg> Dashboard</a>
      <a href="/admin/lessons" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg> Lessons</a>
      <a href="/admin/assignments"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg> Assignments</a>
      <a href="/admin/users"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg> Users</a>
      <a href="/logout" class="logout"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg> Logout</a>
    </nav>
  </div>
  <div class="main-content">
    <div class="page-header">
      <h1>Lesson Progress: <%= lesson.title %></h1>
      <p><% if (lesson.subject) { %><span class="badge badge-primary"><%= lesson.subject %></span> <% } %><%= lesson.date ? 'Date: ' + lesson.date : 'No Date' %> — <%= lesson.description ? lesson.description.slice(0,80) : '' %></p>
    </div>
    <div style="margin-bottom: var(--space-4);">
      <a href="/admin/lessons" class="btn btn-secondary">← Back to Lessons</a>
    </div>

    <div class="card" style="padding: var(--space-4) var(--space-5); margin-bottom: var(--space-5); display:flex; gap: var(--space-4); flex-wrap:wrap;">
      <div class="stat"><div style="font-size:1.6rem; font-weight:800; color: var(--color-success);"><%= done.length %></div><div style="font-size:var(--text-sm); color:var(--text-muted);">Done ✓</div></div>
      <div class="stat"><div style="font-size:1.6rem; font-weight:800; color: var(--color-warning, #f59e0b);"><%= notDone.length %></div><div style="font-size:var(--text-sm); color:var(--text-muted);">Not yet</div></div>
      <div class="stat"><div style="font-size:1.6rem; font-weight:800;"><%= done.length + notDone.length %></div><div style="font-size:var(--text-sm); color:var(--text-muted);">Total students</div></div>
    </div>

    <div class="card" style="padding:0; overflow:hidden; margin-bottom: var(--space-5);">
      <div class="card-header"><h3>✓ Done (<%= done.length %>)</h3></div>
      <% if (!done.length) { %>
        <div style="padding: var(--space-6); text-align:center; color:var(--text-muted);">No student has marked this lesson as done yet.</div>
      <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>#</th><th>Student</th><th>Course</th><th>Year</th><th>SET</th><th>Done At</th></tr></thead>
          <tbody>
            <% done.forEach((s,i) => { %>
              <tr>
                <td><%= i+1 %></td>
                <td class="cell-primary"><%= s.full_name || s.username %> <span style="color:var(--text-muted); font-size:var(--text-xs);">(<%= s.username %>)</span></td>
                <td><%= s.course || '—' %></td>
                <td><span class="badge badge-warning"><%= s.year_level || '—' %></span></td>
                <td class="text-center"><span class="badge badge-set"><%= s.set_group || '—' %></span></td>
                <td class="cell-muted" style="font-size:var(--text-xs);"><%= s.updated_at %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <div class="card" style="padding:0; overflow:hidden;">
      <div class="card-header"><h3>○ Not yet (<%= notDone.length %>)</h3></div>
      <% if (!notDone.length) { %>
        <div style="padding: var(--space-6); text-align:center; color:var(--text-muted);">All students have completed this lesson! 🎉</div>
      <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>#</th><th>Student</th><th>Course</th><th>Year</th><th>SET</th></tr></thead>
          <tbody>
            <% notDone.forEach((s,i) => { %>
              <tr>
                <td><%= i+1 %></td>
                <td class="cell-primary"><%= s.full_name || s.username %> <span style="color:var(--text-muted); font-size:var(--text-xs);">(<%= s.username %>)</span></td>
                <td><%= s.course || '—' %></td>
                <td><span class="badge badge-warning"><%= s.year_level || '—' %></span></td>
                <td class="text-center"><span class="badge badge-set"><%= s.set_group || '—' %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <footer class="footer">
      &copy; 2026 Student Portal System &mdash; Developed by <strong>BART</strong> | Crafted with &hearts; for Education<br>
      <small>All Rights Reserved &bull; Made in the Philippines &bull; v1.0</small>
    </footer>
  </div>
</body>
</html>
