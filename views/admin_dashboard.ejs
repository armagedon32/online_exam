<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard — Online Exam System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="sidebar">
    <div class="logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
    </div>
      <div class="sidebar-profile">
        <div class="avatar"><%= (user && (user.full_name || user.username) ? (user.full_name || user.username).charAt(0).toUpperCase() : 'A') %></div>
        <div class="profile-meta">
          <span class="profile-name"><%= user ? (user.full_name || user.username) : 'Admin' %></span>
          <span class="profile-role">Administrator</span>
        </div>
      </div>
    <nav>
      <a href="/admin" class="active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg>
        Dashboard
      </a>
      <a href="/admin/questions/add">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
        Questions
      </a>
      <a href="/admin/exams/create">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        Create Exam
      </a>
      <a href="/admin/scores">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>
        Scores
      </a>
      <a href="/admin/users">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        Users
      </a>
      <a href="/admin/settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1 2.83-2.83l-.06-.06A1.65 1.65 0 0 0 9 15a1.65 1.65 0 0 0-1-1.51V13a1.65 1.65 0 0 0 1-1.51 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 13 7a1.65 1.65 0 0 0 1 1.51V9a1.65 1.65 0 0 0-1 1.51 1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1 2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 15a1.65 1.65 0 0 0 1 1.51V17a2 2 0 0 1 4 0v-.09a1.65 1.65 0 0 0 1-1.51z"></path></svg>
        Settings
      </a>
      <a href="/logout" class="logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Logout
      </a>
    </nav>
  </div>

  <div class="main-content">
    <header class="page-header">
      <h1>Dashboard</h1>
      <p>Overview of your online exam system</p>
    </header>

    <div id="alertSuccess" class="alert alert-success" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      <span id="alertSuccessText"></span>
      <button type="button" class="close" aria-label="Dismiss">&times;</button>
    </div>
    <div id="alertError" class="alert alert-danger" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      <span id="alertErrorText"></span>
      <button type="button" class="close" aria-label="Dismiss">&times;</button>
    </div>
    <div id="alertWarning" class="alert alert-warning" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      <span id="alertWarningText"></span>
      <button type="button" class="close" aria-label="Dismiss">&times;</button>
    </div>

    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-value primary"><%= total_questions %></div>
        <div class="stat-label">Total Questions</div>
      </div>
      <div class="stat-card">
        <div class="stat-value success"><%= total_exams %></div>
        <div class="stat-label">Total Exams</div>
      </div>
      <div class="stat-card">
        <div class="stat-value warning"><%= total_students %></div>
        <div class="stat-label">Total Students</div>
      </div>
    </div>

    <div class="card" style="margin-top: var(--space-6);">
      <div class="card-header">
        <h3>Quick Actions</h3>
      </div>
      <div class="card-body">
        <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
          <a href="/admin/questions/add" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
            Add Question
          </a>
          <a href="/admin/exams/create" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Create Exam
          </a>
          <a href="/admin/users" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            Manage Users
          </a>
          <a href="/admin/settings" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06-.06a2 2 0 1 1 2.83-2.83l-.06-.06A1.65 1.65 0 0 0 9 15a1.65 1.65 0 0 0-1-1.51V13a1.65 1.65 0 0 0 1-1.51 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 13 7a1.65 1.65 0 0 0 1 1.51V9a1.65 1.65 0 0 0-1 1.51 1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1 2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 15a1.65 1.65 0 0 0 1 1.51V17a2 2 0 0 1 4 0v-.09a1.65 1.65 0 0 0 1-1.51z"></path></svg>
            Settings
          </a>
          <a href="/admin/scores" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>
            View Scores
          </a>
        </div>
      </div>
    </div>

    <div class="card" style="margin-top: var(--space-6);">
      <div class="card-header">
        <h3>Recent Questions</h3>
        <span><%= questions ? questions.length : 0 %> total</span>
      </div>
      <div class="card-body" style="padding: 0;">
        <% if (questions && questions.length) { %>
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Subject</th>
                  <th>Question</th>
                  <th>Correct</th>
                  <th>Created</th>
                </tr>
              </thead>
              <tbody>
                <% questions.slice(0, 10).forEach((q, idx) => { %>
                  <tr>
                    <td class="cell-muted"><%= q.id %></td>
                    <td><span class="badge badge-primary"><%= q.subject %></span></td>
                    <td class="cell-primary" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= q.question %></td>
                    <td><span class="badge badge-success"><%= q.correct_answer %></span></td>
                    <td class="cell-muted" style="font-size: var(--text-xs);"><%= new Date(q.created_at).toLocaleDateString() %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% if (questions.length > 10) { %>
            <div style="padding: var(--space-4); text-align: center; border-top: 1px solid var(--border-light);">
              <a href="/admin/questions/add" class="btn btn-ghost btn-sm">View all <%= questions.length %> questions</a>
            </div>
          <% } %>
        <% } else { %>
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
            <h3>No questions yet</h3>
            <p>Start building your question bank by adding your first question.</p>
            <a href="/admin/questions/add" class="btn btn-primary" style="margin-top: var(--space-4);">Add Question</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <footer class="footer">
    &copy; 2026 Online Exam System &mdash; Developed by <strong>BART</strong> | Crafted with &hearts; for Education<br>
    <small>All Rights Reserved &bull; Made in the Philippines &bull; v1.0</small>
  </footer>

  <script>
    const qs = new URLSearchParams(location.search);
    function show(id, textId, msg) {
      if (msg) {
        const el = document.getElementById(textId);
        const alertEl = document.getElementById(id);
        el.textContent = decodeURIComponent(msg.replace(/\+/g, ' '));
        alertEl.classList.add('show');
        setTimeout(() => alertEl.classList.remove('show'), 6000);
      }
    }
    show('alertSuccess', 'alertSuccessText', qs.get('success'));
    show('alertError', 'alertErrorText', qs.get('error'));
    show('alertWarning', 'alertWarningText', qs.get('warning'));
    document.querySelectorAll('.alert .close').forEach(btn => {
      btn.addEventListener('click', () => btn.closest('.alert').classList.remove('show'));
    });
  </script>
</body>
</html>