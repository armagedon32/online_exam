<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Questions - Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="sidebar">
    <div class="logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
    </div>
      <div class="sidebar-profile">
        <div class="avatar"><%= (user && (user.full_name || user.username) ? (user.full_name || user.username).charAt(0).toUpperCase() : 'A') %></div>
        <div class="profile-meta">
          <span class="profile-name"><%= user ? (user.full_name || user.username) : 'Admin' %></span>
          <span class="profile-role">Administrator</span>
        </div>
      </div>
    <nav>
      <a href="/admin">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg>
        Dashboard
      </a>
      <a href="/admin/questions" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
        Questions
      </a>
      <a href="/admin/questions"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg> Question Bank</a>
      <a href="/admin/exams/create">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        Create Exam
      </a>
      <a href="/admin/lessons">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        Lessons
      </a>
      <a href="/admin/assignments">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></path><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
        Assignments
      </a>
      <a href="/admin/scores">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>
        Scores
      </a>
      <a href="/admin/users">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        Users
      </a>
      <a href="/admin/settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82-.33l-.06-.06a2 2 0 1 1 2.83-2.83l-.06-.06A1.65 1.65 0 0 0 9 15a1.65 1.65 0 0 0-1-1.51V13a1.65 1.65 0 0 0 1-1.51 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l-.06-.06A1.65 1.65 0 0 0 13 7a1.65 1.65 0 0 0 1-1.51V9a1.65 1.65 0 0 0 1-1.51 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l-.06-.06A1.65 1.65 0 0 0 13 7a1.65 1.65 0 0 0 1-1.51V9a1.65 1.65 0 0 0 1-1.51 1.65 1.65 0 0 0 .33 1.82l-.06-.06a2 2 0 1 1 2.83-2.83l-.06-.06A1.65 1.65 0 0 0 15 15a1.65 1.65 0 0 0 1 1.51V17a2 2 0 0 1 4 0v-.09a1.65 1.65 0 0 0 1-1.51z"></path></svg>
        Settings
      </a>
      <a href="/logout" class="logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></path><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Logout
      </a>
    </nav>
  </div>

  <div class="main-content">
    <header class="page-header">
      <h1>Questions</h1>
      <p>Manage your question bank</p>
    </header>

    <div id="alertSuccess" class="alert alert-success" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      <span id="alertSuccessText"></span>
      <button type="button" class="close" aria-label="Dismiss">&times;</button>
    </div>
    <div id="alertError" class="alert alert-danger" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      <span id="alertErrorText"></span>
      <button type="button" class="close" aria-label="Dismiss">&times;</button>
    </div>
    <div id="alertWarning" class="alert alert-warning" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      <span id="alertWarningText"></span>
      <button type="button" class="close" aria-label="Dismiss">&times;</button>
    </div>

    <div class="card">
      <div class="card-header" style="flex-wrap: wrap; gap: var(--space-3); align-items: center;">
        <h3>Question Bank</h3>
        <div style="display:flex; align-items:center; gap: var(--space-3); flex-wrap: wrap; margin-left: auto;">
          <label class="select-all-control" style="display:flex; align-items:center; gap: var(--space-2); font-size: var(--text-sm); cursor:pointer; color: var(--text-primary);">
            <input type="checkbox" id="selectAllCb" style="width:16px;height:16px;accent-color:var(--color-primary);cursor:pointer;">
            <strong>Select All</strong>
          </label>
          <span id="selectedCount" class="meta">Selected: 0 questions</span>
          <button type="button" id="headerDeleteBtn" class="btn btn-danger" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="width:16px;height:16px;margin-right:4px;"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path></svg>
            Delete Selected
          </button>
          <a href="/admin/questions/add" class="btn btn-primary" style="margin-left:auto;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="width:16px;height:16px;margin-right:4px;"><path d="M12 5v14M5 12h14"></path></svg>
            Add Question
          </a>
        </div>
      </div>
      <div class="card-body">
        <div class="filter-toolbar" style="display:flex; gap: var(--space-3); flex-wrap: wrap; align-items: center; margin-bottom: var(--space-4);">
          <div style="flex: 1 1 240px; min-width: 0;">
            <input type="search" id="questionSearch" class="form-control" placeholder="Search questions&hellip; (type to filter below)" autocomplete="off">
          </div>
          <div style="display:flex; align-items:center; gap: var(--space-2);">
            <label for="subject" class="form-label" style="margin: 0; white-space: nowrap;">Subject:</label>
            <select id="subject" class="form-control" style="width: auto; min-width: 180px;">
              <option value="">All Subjects</option>
              <% if (subjects && subjects.length) { %>
                <% subjects.forEach(s => { %>
                  <option value="<%= s.name %>"><%= s.code ? s.code + ' - ' : '' %><%= s.name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div style="display:flex; align-items:center; gap: var(--space-2);">
            <label for="questionDateFilter" class="form-label" style="margin: 0; white-space: nowrap;">Added:</label>
            <select id="questionDateFilter" class="form-control" style="width: auto;">
              <option value="all">All dates</option>
              <option value="7">Last 7 days</option>
              <option value="30">Last 30 days</option>
              <option value="0">Today</option>
            </select>
          </div>
        </div>

        <div id="filterHint" class="alert alert-info" style="display: flex; margin-bottom: var(--space-4);">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
          <span id="filterHintText">Select a Subject above to see its questions. Questions are grouped by Subject you created in <b>Questions → Subject</b>.</span>
        </div>

        <form action="/admin/questions/delete" method="post" id="questionsForm">
          <div id="questions-list" class="questions-list">
            <% if (typeof questions !== 'undefined' && questions.length) { %>
              <% let subjIdx = {}; %>
              <% questions.forEach((q) => { %>
                <% subjIdx[q.subject] = (subjIdx[q.subject] || 0) + 1; %>
                <label class="checkbox-item q-item" data-subject="<%= q.subject %>" data-created="<%= q.created_at || '' %>">
                  <input type="checkbox" name="ids" value="<%= q.id %>">
                  <div style="flex: 1; min-width: 0;">
                    <div style="display:flex; align-items:center; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-2);">
                      <span class="badge badge-neutral" style="font-size: var(--text-xs);">Q<%= subjIdx[q.subject] %></span>
                      <span class="badge badge-primary"><%= q.subject %></span>
                      <span class="badge badge-success">Correct: <%= q.correct_answer %></span>
                      <span class="badge badge-success" style="font-size: var(--text-xs);"><%= new Date(q.created_at || Date.now()).toLocaleString('en-PH',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></span>
                    </div>
                    <p style="margin: 0 0 var(--space-2); font-weight: var(--font-medium); color: var(--text-primary);"><%= q.question %></p>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); font-size: var(--text-sm);">
                      <span class="<%= q.correct_answer==='A'?'fw-bold text-primary':'' %>"><strong>A.</strong> <%= q.option_a %></span>
                      <span class="<%= q.correct_answer==='B'?'fw-bold text-primary':'' %>"><strong>B.</strong> <%= q.option_b %></span>
                      <span class="<%= q.correct_answer==='C'?'fw-bold text-primary':'' %>"><strong>C.</strong> <%= q.option_c %></span>
                      <span class="<%= q.correct_answer==='D'?'fw-bold text-primary':'' %>"><strong>D.</strong> <%= q.option_d %></span>
                    </div>
                  </div>
                </label>
              <% }) %>
            <% } else { %>
              <div class="empty-state" style="padding: var(--space-8);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                <h3>No questions yet</h3>
                <p>Start building your question bank by adding your first question.</p>
                <a href="/admin/questions/add" class="btn btn-primary" style="margin-top: var(--space-4);">Add Question</a>
              </div>
            <% } %>
          </div>

          <div class="card-footer" style="display:flex; gap:var(--space-3); justify-content:flex-end; margin-top:var(--space-4); padding-top:var(--space-4); border-top:1px solid var(--border);">
            <span id="selectedCount" class="meta" style="align-self:center;">Selected: 0 questions</span>
            <button type="submit" class="btn btn-danger" id="deleteBtn" disabled>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="width:16px;height:16px;margin-right:4px;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
              Delete Selected
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <footer class="footer">
    &copy; 2026 Student Portal System &mdash; Developed by <strong>BART</strong> | Crafted with &hearts; for Education<br>
    <small>All Rights Reserved &bull; Made in the Philippines &bull; v1.0</small>
  </footer>

  <script>
    const qs = new URLSearchParams(location.search);
    function show(id, textId, msg) {
      if (msg) {
        const el = document.getElementById(textId);
        const alertEl = document.getElementById(id);
        el.textContent = decodeURIComponent(msg.replace(/\+/g, ' '));
        alertEl.classList.add('show');
        setTimeout(() => alertEl.classList.remove('show'), 6000);
      }
    }
    show('alertSuccess', 'alertSuccessText', qs.get('success'));
    show('alertError', 'alertErrorText', qs.get('error'));
    show('alertWarning', 'alertWarningText', qs.get('warning'));
    document.querySelectorAll('.alert .close').forEach(btn => {
      btn.addEventListener('click', () => btn.closest('.alert').classList.remove('show'));
    });

    document.addEventListener('DOMContentLoaded', function() {
      const boxes = document.querySelectorAll('#questions-list input[type="checkbox"]');
      const counter = document.getElementById('selectedCount');
      const deleteBtn = document.getElementById('deleteBtn');
      const subjectSelect = document.getElementById('subject');
      const items = document.querySelectorAll('.q-item');
      const hint = document.getElementById('filterHint');
      const hintText = document.getElementById('filterHintText');
      const selectAllCb = document.getElementById('selectAllCb');
      const searchInput = document.getElementById('questionSearch');
      const dateFilterCtl = document.getElementById('questionDateFilter');
      const questionsForm = document.getElementById('questionsForm');

      function visibleBoxes() {
        return [...boxes].filter(cb => cb.closest('.q-item').style.display !== 'none');
      }
      function refreshSelectAll() {
        if (!selectAllCb) return;
        const vis = visibleBoxes();
        selectAllCb.checked = vis.length > 0 && vis.every(cb => cb.checked);
        selectAllCb.indeterminate = vis.length > 0 && !selectAllCb.checked && vis.some(cb => cb.checked);
      }
      function update() {
        const n = document.querySelectorAll('#questions-list input:checked').length;
        counter.textContent = 'Selected: ' + n + ' question' + (n !== 1 ? 's' : '');
        deleteBtn.disabled = n === 0;
        headerDeleteBtn.disabled = n === 0;
        document.querySelectorAll('.q-item').forEach(el => {
          const cb = el.querySelector('input');
          if (cb && cb.checked) el.classList.add('checked'); else el.classList.remove('checked');
        });
        refreshSelectAll();
      }

      function filterQuestions() {
        const sel = subjectSelect ? subjectSelect.value : '';
        const qtext = (searchInput ? searchInput.value : '').trim().toLowerCase();
        const dval = dateFilterCtl ? dateFilterCtl.value : 'all';
        const now = Date.now();
        const DAY = 86400000;
        function withinDays(s) {
          if (!dval || dval === 'all') return true;
          if (!s) return true;
          const d = new Date(String(s).replace(' ', 'T') + 'Z');
          if (isNaN(d.getTime())) return true;
          const days = Math.floor((now - d.getTime()) / DAY);
          return days >= 0 && days <= parseInt(dval, 10);
        }
        let visible = 0;
        items.forEach(it => {
          let show = !sel || it.dataset.subject === sel;
          if (show && qtext) show = (it.textContent || '').toLowerCase().indexOf(qtext) !== -1;
          if (show) show = withinDays(it.dataset.created);
          it.style.display = show ? 'flex' : 'none';
          if (!show) it.querySelector('input').checked = false;
          if (show) visible++;
        });
        update();
        hint.style.display = 'block';
        if (!sel && !qtext && (!dval || dval === 'all')) {
          hintText.textContent = 'Showing all ' + items.length + ' questions — pick a Subject, type to Search, or use the Added date filter.';
          hint.className = 'alert alert-success';
          hint.querySelector('svg').outerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>';
        } else if (visible === 0) {
          hintText.textContent = 'No questions for "' + sel + '" — go to Questions and create questions for this subject first.';
          hint.className = 'alert alert-warning';
          hint.querySelector('svg').outerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>';
        } else {
          hintText.textContent = 'Showing ' + visible + ' question' + (visible !== 1 ? 's' : '') + ' for "' + sel + '" — select to delete.';
          hint.className = 'alert alert-info';
          hint.querySelector('svg').outerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>';
        }
      }

      if (selectAllCb) {
        selectAllCb.addEventListener('change', () => {
          visibleBoxes().forEach(cb => cb.checked = selectAllCb.checked);
          update();
        });
      }

      boxes.forEach(b => b.addEventListener('change', update));
      if (subjectSelect) subjectSelect.addEventListener('change', filterQuestions);
      if (searchInput) searchInput.addEventListener('input', filterQuestions);
      if (dateFilterCtl) dateFilterCtl.addEventListener('change', filterQuestions);

      if (questionsForm) {
        questionsForm.addEventListener('submit', function(e) {
          const checked = document.querySelectorAll('#questions-list input:checked');
          if (checked.length === 0) {
            e.preventDefault();
            return;
          }
          if (!confirm('Delete ' + checked.length + ' selected question(s)? This cannot be undone.')) {
            e.preventDefault();
          }
        });
      }

      // Header "Delete Selected" button submits the same form (it's outside the <form>, type="button").
      const headerDeleteBtn = document.getElementById('headerDeleteBtn');
      if (headerDeleteBtn) {
        headerDeleteBtn.addEventListener('click', function() {
          const n = document.querySelectorAll('#questions-list input:checked').length;
          if (n === 0) return;
          if (confirm('Delete ' + n + ' selected question(s)? This cannot be undone.')) {
            questionsForm.requestSubmit();
          }
        });
      }

      filterQuestions();
    });
  </script>

  <style>
    .questions-list { display: flex; flex-direction: column; gap: var(--space-3); }
    .q-item { transition: all var(--transition-fast); }
    .q-item.checked { border-color: var(--color-danger); background: #fef2f2; }
    .q-item input:focus-visible + div { outline: 2px solid var(--color-primary); outline-offset: 2px; border-radius: var(--radius-sm); }
    .fw-bold { font-weight: var(--font-bold); }
    .text-primary { color: var(--color-primary); }
  </style>
  <script src="/notifications.js"></script>
</body>
</html>