<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Quizzes — Student Portal System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="sidebar">
    <div class="logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
    </div>
      <div class="sidebar-profile">
        <div class="avatar"><%= (user && (user.full_name || user.username) ? (user.full_name || user.username).charAt(0).toUpperCase() : 'A') %></div>
        <div class="profile-meta">
          <span class="profile-name"><%= user ? (user.full_name || user.username) : 'Admin' %></span>
          <span class="profile-role">Administrator</span>
        </div>
      </div>
    <nav>
      <a href="/admin">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg>
        Dashboard
      </a>
      <a href="/admin/questions"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
        Questions
      </a>
      <a href="/admin/quizzes">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        Quizzes
      </a>
      <a href="/admin/quizzes/create">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
        Create Quiz
      </a>
      <a href="/admin/lessons">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        Lessons
      </a>
      <a href="/admin/assignments">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
        Assignments
      </a>
      <a href="/admin/messages">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        Messages
      </a>
      <a href="/admin/scores">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>
        Scores
      </a>
      <a href="/admin/quiz-scores"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg> Quiz Scores</a>
      <a href="/admin/users">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        Users
      </a>
      <a href="/admin/settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06-.06a2 2 0 1 1 2.83-2.83l-.06-.06A1.65 1.65 0 0 0 9 15a1.65 1.65 0 0 0-1-1.51V13a1.65 1.65 0 0 0 1-1.51 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 13 7a1.65 1.65 0 0 0 1 1.51V9a1.65 1.65 0 0 0-1 1.51 1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1 2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 15a1.65 1.65 0 0 0 1 1.51V17a2 2 0 0 1 4 0v-.09a1.65 1.65 0 0 0 1-1.51z"></path></svg>
        Settings
      </a>
      <a href="/logout" class="logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Logout
      </a>
    </nav>
  </div>

  <div class="main-content">
    <header class="page-header">
      <h1>Manage Quizzes</h1>
      <p>Reopen past-due or disabled quizzes so students can take them again</p>
    </header>

    <div id="alertSuccess" class="alert alert-success"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg><span id="alertSuccessText"></span><button class="close" onclick="this.parentElement.classList.remove('show')">&times;</button></div>
    <div id="alertError" class="alert alert-danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg><span id="alertErrorText"></span><button class="close" onclick="this.parentElement.classList.remove('show')">&times;</button></div>

    <div class="card" style="padding:0; overflow:hidden;">
      <div class="card-header">
        <h3>All Quizzes (<%= quizzes.length %>)</h3>
        <span style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
          <span class="meta">Students can only take quizzes that are Open</span>
          <a href="/admin/quiz-scores" class="btn btn-secondary btn-sm">View Quiz Scores</a>
        </span>
      </div>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>#</th>
              <th>Title</th>
              <th>Subject</th>
              <th>Period</th>
              <th>Questions</th>
              <th>Due Date</th>
              <th>Status</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!quizzes.length) { %>
              <tr><td colspan="8" style="text-align:center; color:var(--text-muted); padding:1.5rem;">No quizzes yet. <a href="/admin/quizzes/create">Create your first quiz</a>.</td></tr>
            <% } %>
            <% quizzes.forEach(e => { %>
              <tr>
                <td><%= e.id %></td>
                <td class="cell-primary" style="max-width:220px;"><%= e.title %></td>
                <td><span class="badge badge-subj"><%= e.subject %></span></td>
                <td>
                  <span class="badge badge-set"><%= e.semester || '—' %></span>
                  <span class="badge badge-warning"><%= e.period || '—' %></span>
                </td>
                <td class="text-center"><%= e.question_count || 0 %></td>
                <td><% if (e.due_date) { %><span class="cell-muted"><%= e.due_date %><br><small>(until 11:59 PM)</small></span><% } else { %><span class="cell-muted">No due date</span><% } %></td>
                <td>
                  <% if (e.closed) { %>
                    <span class="badge badge-danger"><%= Number(e.active) === 0 ? 'Disabled' : 'Closed' %></span>
                  <% } else { %>
                    <span class="badge badge-success">Open</span>
                  <% } %>
                </td>
                <td class="text-right">
                  <div class="actions">
                    <% if (e.closed) { %>
                    <form action="/admin/quizzes/reopen" method="post" class="d-inline" data-message="Reopen \"<%= e.title %>\" for 7 more days? Students will be notified." data-confirm-text="Reopen">
                      <input type="hidden" name="id" value="<%= e.id %>">
                      <input type="hidden" name="days" value="7">
                      <button class="btn btn-success btn-sm" type="submit">Reopen +7 days</button>
                    </form>
                    <% } else { %>
                    <form action="/admin/quizzes/set-active" method="post" class="d-inline" data-message="Disable \"<%= e.title %>\"? Students will no longer be able to take it." data-confirm-text="Disable" data-danger="true">
                      <input type="hidden" name="id" value="<%= e.id %>">
                      <input type="hidden" name="active" value="0">
                      <button class="btn btn-danger btn-sm" type="submit">Disable</button>
                    </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <footer class="footer">
      &copy; 2026 Student Portal System &mdash; Developed by <strong>BART</strong> | Crafted with &hearts; for Education<br>
      <small>All Rights Reserved &bull; Made in the Philippines &bull; v1.0</small>
    </footer>
  </div>

  <script>
    const qs = new URLSearchParams(location.search);
    function show(id, textId, msg) {
      if (msg) {
        const el = document.getElementById(textId);
        const alertEl = document.getElementById(id);
        el.textContent = decodeURIComponent(msg.replace(/\+/g, ' '));
        alertEl.classList.add('show');
        setTimeout(() => alertEl.classList.remove('show'), 6000);
      }
    }
    show('alertSuccess', 'alertSuccessText', qs.get('success'));
    show('alertError', 'alertErrorText', qs.get('error'));
    document.querySelectorAll('.alert .close').forEach(btn => {
      btn.addEventListener('click', () => btn.closest('.alert').classList.remove('show'));
    });
    // Confirm dialog for destructive/important actions
    document.querySelectorAll('form[data-message]').forEach(f => {
      f.addEventListener('submit', function(e) {
        const msg = this.getAttribute('data-message');
        if (msg && !window.confirm(msg)) e.preventDefault();
      });
    });
  </script>
</body>
</html>