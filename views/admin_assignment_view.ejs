<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= assignment.title %> — Submissions</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="sidebar">
    <div class="logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div>
      <div class="sidebar-profile">
        <div class="avatar"><%= (user && (user.full_name || user.username) ? (user.full_name || user.username).charAt(0).toUpperCase() : 'A') %></div>
        <div class="profile-meta">
          <span class="profile-name"><%= user ? (user.full_name || user.username) : 'Admin' %></span>
          <span class="profile-role">Administrator</span>
        </div>
      </div>
    <nav>
      <a href="/admin"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg> Dashboard</a>
      <a href="/admin/questions/add"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"></path></svg> Questions</a>
      <a href="/admin/exams/create"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"></polyline></svg> Create Exam</a>
      <a href="/admin/lessons"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg> Lessons</a>
      <a href="/admin/assignments" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg> Assignments</a>
      <a href="/admin/scores"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg> Scores</a>
      <a href="/admin/users"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg> Users</a>
      <a href="/admin/settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06-.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 9 15a1.65 1.65 0 0 0-1-1.51V13a1.65 1.65 0 0 0 1-1.51 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 13 7a1.65 1.65 0 0 0 1 1.51V9a1.65 1.65 0 0 0-1 1.51 1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1 2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 15a1.65 1.65 0 0 0 1 1.51V17a2 2 0 0 1 4 0v-.09a1.65 1.65 0 0 0 1-1.51z"></path></svg> Settings</a>
      <a href="/logout" class="logout"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg> Logout</a>
    </nav>
  </div>
  <div class="main-content">
    <div class="page-header">
      <h1><%= assignment.title %></h1>
      <p>
        <% if (assignment.subject) { %><span class="badge badge-primary"><%= assignment.subject %></span> <% } %>
        <% if (assignment.due_date) { %>Due: <span class="badge badge-warning"><%= assignment.due_date %></span><% } else { %>No due date<% } %>
      </p>
    </div>

    <% if (assignment.description) { %>
      <div class="card" style="margin-bottom: var(--space-4);">
        <div class="card-header"><h3>Instructions</h3></div>
        <div class="card-body"><p><%= assignment.description %></p></div>
      </div>
    <% } %>

    <div id="alertSuccess" class="alert alert-success"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg><span id="alertSuccessText"></span><button class="close" onclick="this.parentElement.classList.remove('show')">&times;</button></div>
    <div id="alertError" class="alert alert-danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg><span id="alertErrorText"></span><button class="close" onclick="this.parentElement.classList.remove('show')">&times;</button></div>
    <div id="alertWarning" class="alert alert-warning"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg><span id="alertWarningText"></span><button class="close" onclick="this.parentElement.classList.remove('show')">&times;</button></div>

    <div style="margin-bottom: var(--space-4);">
      <a href="/admin/assignments" class="btn btn-secondary">← Back to Assignments</a>
    </div>

    <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap:var(--space-3); margin-bottom:var(--space-6);">
      <div class="stat-card"><div class="stat-value primary"><%= submissions.length %></div><div class="stat-label">Submitted</div></div>
      <div class="stat-card"><div class="stat-value warning"><%= notSubmitted.length %></div><div class="stat-label">Not Yet Submitted</div></div>
    </div>

    <div class="card" style="margin-bottom:var(--space-6); padding:0; overflow:hidden;">
      <div class="card-header"><h3>Submissions (<%= submissions.length %>)</h3></div>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Student</th>
              <th>SET</th>
              <th>Text / Response</th>
              <th>File</th>
              <th>Link</th>
              <th>Status</th>
              <th>Score</th>
              <th>Submitted</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (submissions.length === 0) { %>
              <tr><td colspan="9" style="text-align:center; color:var(--text-muted); padding:1.5rem;">No submissions yet.</td></tr>
            <% } %>
            <% submissions.forEach(s => { %>
              <tr style="<%= s.status === 'done' ? 'background: var(--bg-tertiary); opacity:0.85;' : '' %>">
                <td class="cell-primary"><%= s.full_name || s.username %></td>
                <td><span class="badge badge-set"><%= s.set_group || '—' %></span></td>
                <td style="max-width:250px; font-size:var(--text-sm);">
                  <% if (s.text_response) { %>
                    <div style="white-space:pre-wrap; word-break:break-word;"><%= s.text_response %></div>
                  <% } else { %><span class="cell-muted">—</span><% } %>
                </td>
                <td>
                  <% if (s.file_name) { %>
                    <a href="/admin/assignments/submission/<%= s.id %>/file" class="btn btn-view btn-sm" download="<%= s.file_name %>">📎 <%= s.file_name %></a>
                  <% } else { %><span class="cell-muted">—</span><% } %>
                </td>
                <td>
                  <% if (s.link_url) { %>
                    <a href="<%= s.link_url %>" target="_blank" rel="noopener" style="color:var(--color-primary); font-size:var(--text-sm); word-break:break-all;">🔗 Link</a>
                  <% } else { %><span class="cell-muted">—</span><% } %>
                </td>
                <td>
                  <% if (s.status === 'done') { %>
                    <span class="badge badge-success">Done</span>
                  <% } else { %>
                    <span class="badge badge-warning">Submitted</span>
                  <% } %>
                </td>
                <td>
                  <% if (s.score || s.feedback) { %>
                    <span class="badge badge-primary" style="font-size:var(--text-sm);"><%= s.score || '—' %></span>
                    <% if (s.feedback) { %><div style="font-size:var(--text-xs); color:var(--text-muted); margin-top:var(--space-1); max-width:140px;">💬 <%= s.feedback %></div><% } %>
                  <% } else { %><span class="cell-muted">—</span><% } %>
                </td>
                <td class="cell-muted" style="font-size:var(--text-xs);"><%= s.submitted_at %></td>
                <td class="text-right">
                  <div class="actions">
                    <button class="btn <%= s.status === 'done' ? 'btn-edit' : 'btn-success' %> btn-sm" onclick="openGrade(<%= s.id %>)"><%= s.status === 'done' ? 'Re-Grade' : 'Grade' %></button>
                  </div>
                </td>
              </tr>
              <!-- Grade Modal -->
              <div id="grade-<%= s.id %>" class="modal" onclick="if(event.target===this) closeGrade(<%= s.id %>)">
                <div class="modal-card" style="max-width:440px;">
                  <div class="modal-header"><h3>Grade — <%= s.full_name || s.username %></h3><button class="close-modal" onclick="closeGrade(<%= s.id %>)">&times;</button></div>
                  <form action="/admin/assignments/submission/grade" method="post">
                    <input type="hidden" name="submission_id" value="<%= s.id %>">
                    <input type="hidden" name="assignment_id" value="<%= assignment.id %>">
                    <div class="form-group">
                      <label>Score</label>
                      <input type="text" name="score" value="<%= s.score || '' %>" placeholder="e.g., 95 / 100 — or A / B / P">
                    </div>
                    <div class="form-group">
                      <label>Feedback (optional)</label>
                      <textarea name="feedback" rows="3" placeholder="Comment for the student..."><%= s.feedback || '' %></textarea>
                    </div>
                    <div class="card-footer">
                      <button type="button" class="btn btn-secondary" onclick="closeGrade(<%= s.id %>)">Cancel</button>
                      <button type="submit" class="btn btn-primary">Save & Mark Done</button>
                    </div>
                  </form>
                </div>
              </div>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (notSubmitted.length > 0) { %>
      <div class="card" style="padding:0; overflow:hidden;">
        <div class="card-header"><h3>Not Yet Submitted (<%= notSubmitted.length %>)</h3></div>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr><th>Student</th><th>Username</th><th>Course</th><th>Year</th><th>SET</th></tr>
            </thead>
            <tbody>
              <% notSubmitted.forEach(ns => { %>
                <tr>
                  <td class="cell-primary"><%= ns.full_name || '—' %></td>
                  <td><%= ns.username %></td>
                  <td><%= ns.course || '—' %></td>
                  <td><span class="badge badge-warning"><%= ns.year_level || '—' %></span></td>
                  <td><span class="badge badge-set"><%= ns.set_group || '—' %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>

  <footer class="footer">
    &copy; 2026 Online Exam System &mdash; Developed by <strong>BART</strong> | Crafted with &hearts; for Education<br>
    <small>All Rights Reserved &bull; Made in the Philippines &bull; v1.0</small>
  </footer>
  <script src="/ui.js"></script>
  <script>
    uiShowUrlAlerts();
    function openGrade(id){ document.getElementById('grade-'+id).classList.add('show'); }
    function closeGrade(id){ document.getElementById('grade-'+id).classList.remove('show'); }
  </script>
</body>
</html>